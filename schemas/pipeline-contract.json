  "promotion": {
    "schemaVersion": 2,
    "states": [
      "not-prepared",
      "ready",
      "completed"
    ],
    "schemaPath": ".agents/skills/canon-maintenance/schemas/promotion.schema.json"
  },
  "legacyAcceptance": {
    "schemaVersion": 1,
    "path": "stories/legacy-acceptance.json"
  },
  "sourceManifest": {
    "schemaVersion": 3,
    "verificationStatuses": [
      "verified",
      "descriptive-only"
    ]
  }
