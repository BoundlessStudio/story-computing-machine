{
  "schemaVersion": 2,
  "trustModel": "git-pr-human-review",
  "story": {
    "schemaVersion": 2,
    "fields": [
      "schemaVersion",
      "slug",
      "title",
      "created",
      "stage",
      "status",
      "canon",
      "userDisposition",
      "publish",
      "promotionDate",
      "provenance"
    ],
    "stages": [
      "prompt",
      "canon-research",
      "planning",
      "drafting",
      "draft-review",
      "final-edit",
      "final-review",
      "candidate",
      "final",
      "abandoned"
    ],
    "statuses": [
      "in-progress",
      "candidate",
      "final",
      "abandoned"
    ],
    "userDispositions": [
      "pending",
      "accepted",
      "rejected"
    ],
    "provenanceValues": [
      "pipeline",
      "legacy-user-attested"
    ]
  },
  "lifecycle": {
    "publishableStatuses": [
      "candidate",
      "final"
    ],
    "states": {
      "in-progress": {
        "stages": [
          "prompt",
          "canon-research",
          "planning",
          "drafting",
          "draft-review",
          "final-edit",
          "final-review"
        ],
        "canon": false,
        "userDispositions": [
          "pending"
        ],
        "publish": [
          false
        ],
        "promotionDate": "null"
      },
      "candidate": {
        "stages": [
          "candidate"
        ],
        "canon": false,
        "userDispositions": [
          "pending",
          "accepted"
        ],
        "publish": [
          false,
          true
        ],
        "promotionDate": "null"
      },
      "final": {
        "stages": [
          "final"
        ],
        "canon": true,
        "userDispositions": [
          "accepted"
        ],
        "publish": [
          false,
          true
        ],
        "promotionDate": "required"
      },
      "abandoned": {
        "stages": [
          "abandoned"
        ],
        "canon": false,
        "userDispositions": [
          "rejected"
        ],
        "publish": [
          false
        ],
        "promotionDate": "null"
      }
    }
  },
  "release": {
    "schemaVersion": 3,
    "fields": [
      "schemaVersion",
      "certified",
      "storySlug",
      "certifiedAt",
      "certificationBasis",
      "artifacts",
      "review",
      "nameCheck",
      "dependencies"
    ],
    "artifactContainerFields": [
      "story",
      "canonDelta"
    ],
    "artifactFields": [
      "path"
    ],
    "reviewFields": [
      "artifact",
      "pass",
      "verdict",
      "reviewer",
      "reviewedAt",
      "reviewBasis",
      "unresolvedCritical",
      "unresolvedMajor"
    ],
    "nameCheckFields": [
      "story",
      "phase",
      "passed",
      "checkedAt",
      "checkerVersion",
      "warnings"
    ],
    "dependencyFields": [
      "authorityManifest",
      "handoffLedger"
    ],
    "certificationBases": [
      "pipeline",
      "legacy-user-attested"
    ]
  },
  "reviewPass": {
    "fields": [
      "story",
      "mode",
      "status",
      "pass",
      "reviewedArtifact",
      "authorityManifest",
      "handoffLedger",
      "reviewer",
      "reviewedAt",
      "reviewBasis",
      "verdict",
      "blockType",
      "resolutionOwner",
      "resolutionQuestion",
      "errorCode",
      "unresolvedCounts",
      "priorFindingDispositions",
      "findings",
      "certificationEligible",
      "changeReport"
    ],
    "modes": [
      "REVIEW_DRAFT",
      "REVIEW_FINAL"
    ],
    "persistedStatuses": [
      "READY",
      "USER_RULING_REQUIRED"
    ],
    "verdicts": [
      "PASS",
      "REVISE",
      "BLOCK"
    ]
  },
  "authority": {
    "schemaVersion": 2,
    "fields": [
      "schemaVersion",
      "storySlug",
      "capturedAt",
      "baseBranch",
      "baseCommit",
      "universeFiles",
      "canonStories"
    ]
  },
  "handoffLedger": {
    "schemaVersion": 3,
    "fields": [
      "schemaVersion",
      "storySlug",
      "entries"
    ],
    "entryFields": [
      "sequence",
      "story",
      "actor",
      "mode",
      "status",
      "startedAt",
      "completedAt",
      "guardId",
      "persister",
      "report",
      "inputs",
      "outputs",
      "errorCode",
      "resolutionOwner",
      "resolutionQuestion"
    ],
    "statuses": [
      "READY",
      "HANDOFF_ERROR",
      "USER_RULING_REQUIRED",
      "NAME_REGISTRATION_REQUIRED"
    ],
    "modeContracts": {
      "RESEARCH_CANON": {
        "actor": "canon_librarian",
        "persister": "coordinator",
        "allowedStages": [
          "prompt",
          "canon-research"
        ],
        "allowedOutputs": [
          "stories/{story}/01-canon-brief.md"
        ],
        "requiredInputs": [
          "stories/{story}/00-prompt.md",
          "stories/{story}/story.json",
          "stories/{story}/authority.json",
          "stories/{story}/handoffs.json"
        ],
        "statuses": [
          "READY",
          "HANDOFF_ERROR",
          "USER_RULING_REQUIRED"
        ],
        "requireAllReadyOutputs": true
      },
      "CREATE_PLAN": {
        "actor": "story_architect",
        "persister": "story_architect",
        "allowedStages": [
          "canon-research",
          "planning"
        ],
        "allowedOutputs": [
          "stories/{story}/02-story-plan.md"
